{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "checkJs": true,

    "module": "NodeNext",

    "moduleResolution": "NodeNext"
  },
  "include": [
    "./tools",
    "./assets/appinfo.json",
    "./package.json",
    "./webpack.config.js",
    "eslint.config.ts",
    "babel.config.js",
    ".prettierrc.js",
    "lint-staged.config.js",
    "postcss.config.ts"
  ],
  // Untyped dev helpers for testing on a TV.
  "exclude": ["./tools/tv"]
}
